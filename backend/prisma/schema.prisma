generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MarketDataAnomalyType {
  FUTURE_BAR
  MISSING_BAR_GAP
  OUTSIDE_SESSION
  PRICE_SANITY
  TOO_OLD_DATA
}

enum AlpacaMarginClassification {
  LIMITED_MARGIN_1X
  REG_T_MARGIN_2X
  INTRADAY_MARGIN_4X
}

model SystemMetadata {
  id        String                   @id @default(cuid())
  key       String                   @unique
  value     String
  status    RecordStatus             @default(ACTIVE)
  version   Int                      @default(0)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  revisions SystemMetadataRevision[]
}

model SystemMetadataRevision {
  id               String   @id @default(cuid())
  systemMetadataId String
  value            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  systemMetadata SystemMetadata @relation(fields: [systemMetadataId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([systemMetadataId, createdAt])
  @@index([systemMetadataId])
  @@index([createdAt])
}

model FinancialConstraintProbe {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(20, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersistentLock {
  id         String   @id
  key        String   @unique
  ownerId    String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@index([ownerId])
}

model SingleOperator {
  id                       String        @id
  username                 String        @unique
  displayName              String
  passwordHash             String?
  enabled                  Boolean       @default(true)
  failedLoginAttempts      Int           @default(0)
  failedLoginWindowStartAt DateTime?
  lastFailedLoginAt        DateTime?
  loginLockedUntil         DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  sessions                 AuthSession[]
  auditEvents              AuditEvent[]
}

model AuthSession {
  id                   String    @id @default(cuid())
  operatorId           String
  tokenHash            String    @unique
  csrfTokenHash        String
  expiresAt            DateTime
  reauthenticatedUntil DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  operator SingleOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([operatorId])
  @@index([expiresAt])
}

enum AuditAction {
  REAUTHENTICATION
  REVOKE_ALL_SESSIONS
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model AuditEvent {
  id            String       @id @default(cuid())
  operatorId    String
  action        AuditAction
  outcome       AuditOutcome
  correlationId String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  operator SingleOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([operatorId])
  @@index([action])
  @@index([outcome])
  @@index([createdAt])
  @@index([correlationId])
}

model PlatformAlpacaOrder {
  id            String   @id @default(cuid())
  alpacaOrderId String   @unique
  clientOrderId String   @unique
  symbol        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([symbol])
  @@index([createdAt])
}

model AlpacaAccountRestrictionSnapshot {
  id                   String                     @id @default(cuid())
  alpacaAccountId      String                     @unique
  accountStatus        String
  marginClassification AlpacaMarginClassification
  multiplier           Int

  tradingBlocked       Boolean
  accountBlocked       Boolean
  transfersBlocked     Boolean
  tradeSuspendedByUser Boolean
  shortingDisabled     Boolean
  leverageDisabled     Boolean

  tradingAllowed   Boolean
  transfersAllowed Boolean
  shortingAllowed  Boolean
  leverageAllowed  Boolean

  buyingPower              Decimal @db.Decimal(20, 8)
  regtBuyingPower          Decimal @db.Decimal(20, 8)
  nonMarginableBuyingPower Decimal @db.Decimal(20, 8)

  initialMargin         Decimal @db.Decimal(20, 8)
  maintenanceMargin     Decimal @db.Decimal(20, 8)
  lastMaintenanceMargin Decimal @db.Decimal(20, 8)
  sma                   Decimal @db.Decimal(20, 8)

  syncedAt  DateTime
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountStatus])
  @@index([marginClassification])
  @@index([tradingAllowed])
  @@index([syncedAt])
}

model MarketDataAnomaly {
  id            String                @id @default(cuid())
  type          MarketDataAnomalyType
  symbol        String?
  timestamp     DateTime?
  referenceAt   DateTime?
  details       Json
  correlationId String?
  detectedAt    DateTime              @default(now())
  createdAt     DateTime              @default(now())

  @@index([type])
  @@index([symbol])
  @@index([timestamp])
  @@index([detectedAt])
  @@index([correlationId])
}

enum MarketDataHaltEventType {
  HALT
  RESUME
}

model MarketDataHaltEvent {
  id            String                  @id @default(cuid())
  type          MarketDataHaltEventType
  symbol        String
  eventAt       DateTime
  receivedAt    DateTime
  statusCode    String
  statusMessage String
  reasonCode    String
  reasonMessage String
  tape          String
  feed          String
  correlationId String?
  createdAt     DateTime                @default(now())

  @@index([type])
  @@index([symbol])
  @@index([eventAt])
  @@index([createdAt])
  @@index([correlationId])
  @@index([symbol, eventAt])
}

model WatchlistSymbol {
  id        String   @id @default(cuid())
  symbol    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model StrategySymbolAssociation {
  id         String   @id @default(cuid())
  strategyId String
  symbol     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([strategyId, symbol])
  @@index([strategyId])
  @@index([symbol])
  @@index([createdAt])
}

model CorporateActionAdjustmentHistory {
  id                  String   @id @default(cuid())
  corporateActionId   String
  corporateActionType String
  symbol              String?
  processDate         DateTime
  adjustmentType      String
  status              String
  details             Json
  recordedAt          DateTime @default(now())

  @@index([corporateActionId])
  @@index([corporateActionType])
  @@index([symbol])
  @@index([processDate])
  @@index([adjustmentType])
  @@index([recordedAt])
}
